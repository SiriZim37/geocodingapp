<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             xmlns:app="http://schemas.android.com/apk/res-auto"
                                             xmlns:tools="http://schemas.android.com/tools"
                                             android:layout_width="match_parent"
                                             android:layout_height="match_parent"
                                             android:background="@android:color/transparent"
                                             tools:background="#3fff00ff">

    <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="@dimen/dialog_padding_horizontal"
            android:layout_marginStart="@dimen/dialog_padding_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_white_corner_radius"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <com.tlt.georepo.view.TLTTextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/custom_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Select Menu"
                android:textColor="@color/black"
                android:textSize="@dimen/text_large_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <View
                android:id="@+id/divier_title"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/unactive"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title" />


        <android.support.v7.widget.AppCompatButton
                android:id="@+id/btn_bg_map"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle_graydark"
                android:fontFamily="@font/custom_bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_12"
                android:text="@string/dil_txt_no"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button_size"
                app:layout_constraintTop_toBottomOf="@id/divier_title"
                android:layout_marginStart="@dimen/margin_12"
                app:layout_constraintStart_toStartOf="parent"/>


        <android.support.v7.widget.AppCompatImageView
                android:id="@+id/btn_map"
                android:layout_width="50dp"
                android:layout_height="52dp"
                android:background="@drawable/ic_map"
                android:fontFamily="@font/custom_bold"
                android:gravity="center"
                android:text="@string/dil_txt_no"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button_size"
                android:elevation="5dp"
                app:layout_constraintStart_toStartOf="@+id/btn_bg_map"
                app:layout_constraintEnd_toEndOf="@+id/btn_bg_map"
                app:layout_constraintTop_toTopOf="@+id/btn_bg_map"
                app:layout_constraintBottom_toBottomOf="@+id/btn_bg_map"/>

        <android.support.v7.widget.AppCompatTextView android:layout_width="wrap_content"
                                                     android:layout_height="wrap_content"
                                                     android:text="Map"
                                                     android:textSize="@dimen/text_medium_size"
                                                     app:layout_constraintTop_toBottomOf="@id/btn_bg_map"
                                                     app:layout_constraintEnd_toEndOf="@+id/btn_bg_map"
                                                     app:layout_constraintStart_toStartOf="@+id/btn_bg_map"/>



        <android.support.v7.widget.AppCompatButton
                android:id="@+id/btnJobDetail"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ic_info2"
                android:fontFamily="@font/custom_bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_12"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button_size"
                app:layout_constraintTop_toBottomOf="@id/divier_title"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="8dp"
                app:layout_constraintStart_toStartOf="parent"/>

        <android.support.v7.widget.AppCompatTextView android:layout_width="wrap_content"
                                                     android:layout_height="wrap_content"
                                                     android:text="Detail"
                                                     android:textSize="@dimen/text_medium_size"
                                                     app:layout_constraintTop_toBottomOf="@id/btnJobDetail"
                                                     app:layout_constraintEnd_toEndOf="@+id/btnJobDetail"
                                                     app:layout_constraintStart_toStartOf="@+id/btnJobDetail"
                                                     android:id="@+id/appCompatTextView3"/>


        <android.support.v7.widget.AppCompatButton
                android:id="@+id/btnGotowork"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle_red"
                android:fontFamily="@font/custom_bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_12"
                android:text="@string/txt_gotowork"
                android:textColor="@color/white"
                android:textSize="@dimen/text_extra_large_size"
                app:layout_constraintTop_toBottomOf="@id/divier_title"
                android:layout_marginEnd="@dimen/margin_12"
                app:layout_constraintEnd_toEndOf="parent"/>
        <android.support.v7.widget.AppCompatTextView android:layout_width="wrap_content"
                                                     android:layout_height="wrap_content"
                                                     android:text="Work Now!"
                                                     android:textSize="@dimen/text_medium_size"
                                                     app:layout_constraintTop_toBottomOf="@id/btnGotowork"
                                                     app:layout_constraintEnd_toEndOf="@+id/btnGotowork"
                                                     app:layout_constraintStart_toStartOf="@+id/btnGotowork"/>


        <com.tlt.georepo.view.TLTButton
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_gray"
                android:fontFamily="@font/custom_bold"
                android:gravity="center"
                android:padding="8dp"
                android:paddingEnd="30dp"
                android:paddingStart="30dp"
                android:text="@string/dil_txt_cancel"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button_size"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginLeft="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appCompatTextView3"/>

    </android.support.constraint.ConstraintLayout>
</android.support.constraint.ConstraintLayout>