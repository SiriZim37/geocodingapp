    <android.support.constraint.ConstraintLayout
            android:id="@+id/nestedscrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <android.support.constraint.ConstraintLayout
                android:id="@+id/ln_languages_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@id/nestedscrollview"
                app:layout_constraintTop_toTopOf="@id/nestedscrollview"
                android:layout_marginRight="@dimen/margin_xlarge"
                android:layout_marginTop="16dp">

            <TextView
                    android:id="@+id/tv_th"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="ไทย"
                    android:gravity="center"
                    android:fontFamily="@font/custom_regular"
                    android:textSize="@dimen/text_large_size"
                    android:background="@drawable/bg_edittext"
                    app:layout_constraintTop_toTopOf="@id/ln_languages_group"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"

            />

            <TextView
                    android:id="@+id/tv_en"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="EN"
                    android:gravity="center"
                    android:background="@drawable/bg_edittext"
                    android:fontFamily="@font/custom_regular"
                    android:textSize="@dimen/text_large_size"
                    android:layout_marginLeft="@dimen/margin_small"
                    app:layout_constraintTop_toTopOf="@id/ln_languages_group"
                    app:layout_constraintStart_toEndOf="@+id/tv_th"

            />


        </android.support.constraint.ConstraintLayout>


        <android.support.constraint.ConstraintLayout
                android:id="@+id/lay_center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/home_content_margin_horizontal"
                android:layout_marginLeft="@dimen/home_content_margin_horizontal"
                app:layout_constraintTop_toTopOf="@+id/nestedscrollview"
                app:layout_constraintBottom_toBottomOf="@+id/nestedscrollview"
                app:layout_constraintStart_toStartOf="@+id/nestedscrollview"
                app:layout_constraintEnd_toEndOf="@+id/nestedscrollview"
                android:layout_gravity="center">

            <android.support.constraint.ConstraintLayout
                    android:id="@+id/lay_center_inner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_normal"
                    android:background="@drawable/big_white_corner_radius"
                    app:layout_constraintTop_toTopOf="@+id/lay_center"
                    android:layout_gravity="center">

                <android.support.v7.widget.AppCompatImageView
                        android:id="@+id/overlapImage1"
                        android:layout_width="95dp"
                        android:layout_height="95dp"
                        android:src="@drawable/geo_icon"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintEnd_toEndOf="@+id/layout_fragment_container"
                        app:layout_constraintTop_toTopOf="@+id/layout_fragment_container"
                />

                <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/ed_firstname"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:hint="@string/firstname"
                        android:drawableLeft="@drawable/profile"
                        android:textSize="@dimen/text_large_size"
                        android:lines="1"
                        android:textColor="@color/DarkRed"
                        android:drawablePadding="@dimen/margin_small"
                        android:fontFamily="@font/custom_regular"
                        android:background="@drawable/bg_edittext"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        app:layout_constraintTop_toBottomOf="@+id/overlapImage1"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintEnd_toStartOf="@id/ed_lastname"
                        android:layout_marginTop="@dimen/margin_normal"
                />

                <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/ed_email"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:fontFamily="@font/custom_regular"
                        android:hint="@string/email"
                        android:textSize="@dimen/text_large_size"
                        android:drawableLeft="@drawable/envelope"
                        android:drawablePadding="@dimen/margin_small"
                        android:lines="1"
                        android:textColor="@color/DarkRed"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_edittext"
                        android:inputType="textEmailAddress"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/ed_firstname"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintEnd_toStartOf="@id/layout_fragment_container"
                        app:layout_constraintBottom_toTopOf="@+id/btn_login"


                />

                <android.support.v7.widget.AppCompatEditText
                        android:maxLength="13"
                        android:id="@+id/ed_idCard"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:fontFamily="@font/custom_regular"
                        android:hint="@string/id_card"
                        android:textSize="@dimen/text_large_size"
                        android:drawableLeft="@drawable/card"
                        android:drawablePadding="@dimen/margin_small"
                        android:lines="1"
                        android:textColor="@color/DarkRed"
                        android:inputType="number"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/ed_email"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintEnd_toStartOf="@id/layout_fragment_container"
                        app:layout_constraintBottom_toTopOf="@+id/btn_login"
                />


                <android.support.design.widget.TextInputEditText
                        android:id="@+id/ed_phone"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:hint="@string/mobile"
                        android:textSize="@dimen/text_large_size"
                        android:maxLength="10"
                        android:lines="1"
                        android:textColor="@color/DarkRed"
                        android:inputType="phone"
                        android:fontFamily="@font/custom_regular"
                        android:drawableLeft="@drawable/phone"
                        android:drawablePadding="@dimen/margin_small"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="@dimen/margin_small"
                        app:layout_constraintTop_toBottomOf="@+id/ed_idCard"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintEnd_toStartOf="@id/ed_lastname"
                />


                <TextView
                        android:id="@+id/bd_datePicker"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:gravity="center"
                        android:fontFamily="@font/custom_regular"
                        android:layout_weight="1"
                        android:inputType="phone"
                        android:background="@drawable/bg_edittext"
                        android:text="@string/dd_mm_year"
                        android:layout_marginTop="@dimen/margin_small"
                        android:drawableLeft="@drawable/cake"
                        android:maxLength="10"
                        android:textColor="@color/DarkRed"
                        android:textSize="@dimen/text_large_size"
                        android:layout_marginLeft="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/ed_idCard"
                        app:layout_constraintStart_toEndOf="@+id/ed_phone"
                        app:layout_constraintEnd_toEndOf="@+id/ed_lastname">
                </TextView>

                <TextView
                        android:id="@+id/tv_company"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_your_company"
                        android:textColor="@color/Gray"
                        android:fontFamily="@font/rsu_regular"
                        android:textSize="@dimen/text_large_size"
                        android:layout_marginTop="@dimen/margin_small"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintTop_toBottomOf="@+id/ed_phone"
                />

                <android.support.v7.widget.AppCompatSpinner
                        android:id="@+id/spinner_company_regist"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/custom_regular"
                        android:drawableLeft="@drawable/card"
                        style="@style/SpinnerItem"
                        app:layout_constraintTop_toBottomOf="@+id/tv_company"
                        android:layout_marginTop="@dimen/margin_small"
                />

                <TextView
                        android:id="@+id/tv_start_working"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:text="@string/start_working_date"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:textSize="@dimen/text_large_size"
                        android:fontFamily="@font/custom_regular"
                        android:drawablePadding="@dimen/margin_small"
                        android:textColor="@color/DarkRed"
                        android:layout_marginLeft="2dp"
                        android:layout_marginTop="@dimen/margin_small"
                        app:layout_constraintTop_toBottomOf="@+id/spinner_company_regist"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintEnd_toStartOf="@id/ed_lastname"
                        android:visibility="gone"
                />


                <TextView
                        android:id="@+id/startWokingDatePicker"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:gravity="center"
                        android:textSize="@dimen/text_large_size"
                        android:layout_weight="1"
                        android:fontFamily="@font/custom_regular"
                        android:background="@drawable/bg_edittext"
                        android:text="@string/dd_mm_year"
                        android:inputType="phone"
                        android:layout_marginTop="@dimen/margin_small"
                        android:drawableLeft="@drawable/ic_calendar"
                        android:drawableTint="@color/grayBG"
                        android:maxLength="10"
                        android:textColor="@color/Gray"
                        android:visibility="gone"
                        android:layout_marginLeft="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/spinner_company_regist"
                        app:layout_constraintStart_toEndOf="@+id/ed_phone"
                        app:layout_constraintEnd_toEndOf="@+id/ed_lastname"
                >

                </TextView>

                <TextView
                        android:id="@+id/tv_completion_date"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:text="@string/completion_date_of"
                        android:gravity="center_vertical"
                        android:textSize="@dimen/text_large_size"
                        android:fontFamily="@font/custom_regular"
                        android:lines="1"
                        android:drawablePadding="@dimen/margin_small"
                        android:layout_marginLeft="2dp"
                        android:textColor="@color/Gray"
                        android:layout_marginTop="@dimen/margin_small"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/tv_start_working"
                        app:layout_constraintStart_toStartOf="@+id/layout_fragment_container"
                        app:layout_constraintEnd_toStartOf="@id/ed_lastname"
                />


                <TextView
                        android:id="@+id/completionDatepicker"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:gravity="center"
                        android:fontFamily="@font/custom_regular"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:text="@string/dd_mm_year"
                        android:textSize="@dimen/text_large_size"
                        android:inputType="phone"
                        android:layout_marginTop="@dimen/margin_small"
                        android:drawableLeft="@drawable/ic_calendar"
                        android:maxLength="10"
                        android:textColor="@color/Gray"
                        android:drawableTint="@color/grayBG"
                        android:visibility="gone"
                        android:layout_marginLeft="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/startWokingDatePicker"
                        app:layout_constraintStart_toEndOf="@+id/ed_phone"
                        app:layout_constraintEnd_toEndOf="@+id/ed_lastname"
                >

                </TextView>


                <android.support.v7.widget.AppCompatEditText
                        app:layout_constraintTop_toBottomOf="@+id/overlapImage1"
                        app:layout_constraintEnd_toEndOf="@+id/layout_fragment_container"
                        app:layout_constraintStart_toEndOf="@id/ed_firstname"
                        android:id="@+id/ed_lastname"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:fontFamily="@font/custom_regular"
                        android:hint="@string/lastname"
                        android:textColor="@color/DarkRed"
                        android:textSize="@dimen/text_large_size"
                        android:lines="1"
                        android:layout_marginTop="@dimen/margin_normal"
                        android:background="@drawable/bg_edittext"
                />

                <FrameLayout
                        android:id="@+id/layout_fragment_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintEnd_toEndOf="@+id/lay_center_inner"
                        app:layout_constraintStart_toStartOf="@+id/lay_center_inner"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@drawable/big_white_corner_radius"/>

            </android.support.constraint.ConstraintLayout>

            <android.support.constraint.ConstraintLayout
                    android:id="@+id/lay_center_bottom"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@+id/lay_center_inner"
                    android:layout_gravity="center">

                <android.support.v7.widget.AppCompatButton
                        android:id="@+id/btn_regist"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/selector_btn_confirm_darkblue"
                        android:text="@string/sign_up"
                        android:textSize="@dimen/text_extra_large_size"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        android:fontFamily="@font/custom_regular"
                        app:layout_constraintStart_toStartOf="@+id/lay_center_bottom"
                        app:layout_constraintEnd_toEndOf="@+id/lay_center_bottom"
                        app:layout_constraintTop_toTopOf="@+id/lay_center_bottom"

                />
            </android.support.constraint.ConstraintLayout>
        </android.support.constraint.ConstraintLayout>
    </android.support.constraint.ConstraintLayout>
</android.support.constraint.ConstraintLayout>