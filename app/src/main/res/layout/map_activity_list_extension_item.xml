<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              xmlns:card_view="http://schemas.android.com/apk/res-auto">

    <android.support.v7.widget.CardView
            android:id="@+id/card_view"
            style="@style/MyCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:clickable="true"
            android:onClick="showMapDetails"
            card_view:cardCornerRadius="1dp">

        <android.support.constraint.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

            <!--<android.support.v7.widget.AppCompatImageView-->
            <!--android:id="@+id/image"-->
            <!--android:layout_width="0dp"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:scaleType="fitCenter"-->
            <!--android:adjustViewBounds="true"-->
            <!--app:layout_constraintEnd_toEndOf="parent"-->
            <!--app:layout_constraintStart_toStartOf="parent"-->
            <!--app:layout_constraintTop_toTopOf="parent"-->
            <!--tools:srcCompat="@drawable/promobanner_1" />-->


            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/title"
                    style="@style/Text_Bold_Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_job_status_no"
                    android:padding="@dimen/padding_small"
                    android:paddingStart="@dimen/padding_normal"
                    android:paddingEnd="@dimen/padding_normal"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="No"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/typeCustomer"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    tools:text="Customer"
                    android:textSize="20dp"
                    android:textColor="@color/gray"
                    app:layout_constraintStart_toEndOf="@id/title"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="8dp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/titleStatus"
                    app:layout_constraintBottom_toBottomOf="@+id/title"/>


            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/titleStatus"
                    style="@style/Text_Bold_Medium"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_job_status"
                    android:padding="@dimen/padding_small"
                    android:paddingStart="@dimen/padding_normal"
                    android:paddingEnd="@dimen/padding_normal"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="@string/txt_type_status_new"/>

            <com.google.android.gms.maps.MapView
                    xmlns:map="http://schemas.android.com/apk/res-auto"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:id="@+id/map"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_margin="8dp"
                    map:liteMode="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/m_unpaid_term"/>

            <android.support.v7.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_book_warn"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/h_location"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/destination"
                    app:layout_constraintTop_toTopOf="@+id/destination"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/destination"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    tools:text="Location"
                    android:padding="@dimen/padding_small"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/gray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/h_location"
                    app:layout_constraintTop_toBottomOf="@+id/map"/>




            <android.support.v7.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_person_black_24dp"
                    android:id="@+id/h_human"
                    app:layout_constraintTop_toTopOf="@+id/cust_name"
                    app:layout_constraintBottom_toTopOf="@+id/txt_reg_no"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginLeft="8dp"
                   />

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/cust_name"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp"
                    android:gravity="start"
                    tools:text="Name"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/DarkGray"
                    app:layout_constraintStart_toEndOf="@id/h_human"
                    app:layout_constraintTop_toBottomOf="@+id/datetime"
                    app:layout_constraintEnd_toEndOf="parent"/>

            <android.support.v7.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_car"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/txt_reg_no"
                    android:id="@+id/h_car"
                    app:layout_constraintBottom_toBottomOf="@+id/txt_reg_no"
                    android:layout_marginLeft="8dp"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/m_reg_no"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="2dp"
                    android:gravity="start"
                    android:text="Reg No :"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/DarkGray"
                    app:layout_constraintTop_toBottomOf="@+id/cust_name"
                    app:layout_constraintStart_toEndOf="@+id/h_car"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/txt_reg_no"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginStart="8dp"
                    android:gravity="start"
                    tools:text="CX-5674"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/DarkGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/m_reg_no"
            app:layout_constraintTop_toBottomOf="@+id/cust_name"/>


            <android.support.v7.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_book_red"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/txt_unpaid_amt"
                    android:id="@+id/h_unpaid"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/txt_unpaid_amt"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/m_unpaid_amt"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="2dp"
                    android:gravity="start"
                    android:textStyle="bold"
                    android:text="@string/txtd_OVER_DUE_AMOUNT"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/DarkGray"
                    app:layout_constraintTop_toBottomOf="@+id/txt_reg_no"
                    app:layout_constraintStart_toEndOf="@+id/h_car"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/txt_unpaid_amt"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    tools:text="0.0"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/DarkGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/txt_reg_no"
                    app:layout_constraintStart_toEndOf="@+id/m_unpaid_amt"/>


            <android.support.v7.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_book_red"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/h_unpaid_term"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/m_unpaid_term"
                    app:layout_constraintTop_toTopOf="@+id/m_unpaid_term"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/m_unpaid_term"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="2dp"
                    android:gravity="start"
                    android:textStyle="bold"
                    android:text="@string/txt_unpaid_amt"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/DarkGray"
                    app:layout_constraintTop_toBottomOf="@+id/txt_unpaid_amt"
                    app:layout_constraintStart_toEndOf="@+id/h_unpaid_term"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/txt_unpaid_term"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    tools:text="0"
                    android:textSize="@dimen/text_medium_size"
                    android:textColor="@color/DarkGray"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_unpaid_amt"
                    app:layout_constraintStart_toEndOf="@+id/m_unpaid_term"/>




            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/datetime"
                    style="@style/Text_Bold_Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="Date - Time"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/Goldenrod"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/titleStatus"/>


            <!--<android.support.v7.widget.AppCompatButton-->
                    <!--android:id="@+id/btnJobDetail"-->
                    <!--android:layout_width="60dp"-->
                    <!--android:layout_height="60dp"-->
                    <!--android:background="@drawable/ic_info2"-->
                    <!--android:fontFamily="@font/custom_bold"-->
                    <!--android:textColor="@color/white"-->
                    <!--android:textSize="@dimen/text_small_size"-->
                    <!--android:layout_marginRight="@dimen/margin_medium"-->
                    <!--app:layout_constraintTop_toBottomOf="@id/destination"-->
                    <!--app:layout_constraintTop_toTopOf="@+id/btnGotowork"-->
                    <!--app:layout_constraintEnd_toStartOf="@+id/btnGotowork"/>-->

            <!--<android.support.v7.widget.AppCompatTextView android:layout_width="wrap_content"-->
                                                         <!--android:layout_height="wrap_content"-->
                                                         <!--android:text="Detail"-->
                                                         <!--app:layout_constraintTop_toBottomOf="@id/btnJobDetail"-->
                                                         <!--app:layout_constraintEnd_toEndOf="@+id/btnJobDetail"-->
                                                         <!--app:layout_constraintStart_toStartOf="@+id/btnJobDetail"/>-->

            <!--<android.support.v7.widget.AppCompatButton-->
                    <!--android:id="@+id/btnGotowork"-->
                    <!--android:layout_width="60dp"-->
                    <!--android:layout_height="60dp"-->
                    <!--android:background="@drawable/btn_red"-->
                    <!--android:fontFamily="@font/custom_bold"-->
                    <!--android:textColor="@color/white"-->
                    <!--android:textSize="@dimen/text_xxlarge_size"-->
                    <!--app:layout_constraintBottom_toBottomOf="parent"-->
                    <!--android:layout_marginEnd="16dp"-->
                    <!--android:text="@string/txt_gotowork"-->
                    <!--app:layout_constraintEnd_toEndOf="parent"-->
                    <!--app:layout_constraintTop_toBottomOf="@id/destination"/>-->
            <!--<android.support.v7.widget.AppCompatTextView android:layout_width="wrap_content"-->
                                                         <!--android:layout_height="wrap_content"-->
                                                         <!--android:text="Work Now!"-->
                                                         <!--app:layout_constraintTop_toBottomOf="@id/btnGotowork"-->
                                                         <!--app:layout_constraintEnd_toEndOf="@+id/btnGotowork"-->
                                                         <!--app:layout_constraintStart_toStartOf="@+id/btnGotowork"/>-->


        </android.support.constraint.ConstraintLayout>

    </android.support.v7.widget.CardView>

</LinearLayout>

