<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/bg_item"
    android:padding="@dimen/margin_normal">

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/contractNo"
            style="@style/Text_Bold_Medium"
            android:layout_width="200dp"
            android:gravity="start"
            android:layout_height="wrap_content"
            android:textColor="@color/grayText"
            app:layout_constraintStart_toStartOf="@+id/typeCustomer"
            tools:text="No" app:layout_constraintTop_toBottomOf="@+id/typeCustomer"
    />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/typeCustomer"
            style="@style/Text_Bold_Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            tools:text="Customer"
            android:textSize="20dp"
            android:textColor="@color/bluedark"
            android:layout_marginEnd="@dimen/margin_xlarge"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"/>


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/titleStatus"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textColor="@color/greenbtn"
            tools:text="@string/txt_type_status_new"
            app:layout_constraintStart_toEndOf="@+id/typeCustomer"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp" app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintBottom_toBottomOf="@+id/typeCustomer"/>

    <android.support.v7.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_pin_orange"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/h_location"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@+id/destination"/>

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/destination"
            style="@style/Text_Bold_Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:layout_marginStart="8dp"
            tools:text="Location"
            android:textSize="@dimen/text_medium_size"
            android:textColor="@color/gray"
            app:layout_constraintStart_toEndOf="@+id/h_location"
            app:layout_constraintTop_toBottomOf="@+id/txt_unpaid_term"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"/>


    <android.support.v7.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_person_black_24dp"
            android:id="@+id/h_human"
            app:layout_constraintBottom_toTopOf="@+id/txt_id_card"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toTopOf="@+id/cust_name"/>

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/cust_name"
            style="@style/Text_Bold_Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:gravity="start"
            tools:text="Name"
            android:textSize="@dimen/text_medium_size"
            android:textColor="@color/DarkGray"
            app:layout_constraintStart_toEndOf="@id/h_human"
            app:layout_constraintTop_toBottomOf="@+id/contractNo"
            app:layout_constraintEnd_toEndOf="parent"/>


        <android.support.v7.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_id_card"
                android:id="@+id/h_idcard"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginLeft="8dp"
                app:layout_constraintTop_toTopOf="@+id/txt_id_card"
                app:layout_constraintBottom_toBottomOf="@+id/txt_id_card"/>

        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/txt_id_card"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginEnd="8dp"
                android:gravity="start"
                tools:text="10XCVB56 (Mock)"
                android:textSize="@dimen/text_medium_size"
                android:textColor="@color/DarkGray"
                app:layout_constraintStart_toEndOf="@id/h_human"
                app:layout_constraintTop_toBottomOf="@+id/cust_name"
                app:layout_constraintEnd_toEndOf="parent"/>



        <android.support.v7.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_car"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txt_reg_no"
                android:id="@+id/h_car"
                app:layout_constraintBottom_toBottomOf="@+id/txt_reg_no"
                android:layout_marginLeft="8dp"/>

        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/m_reg_no"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:gravity="start"
                android:text="@string/reg_no"
                android:textStyle="bold"
                android:textSize="@dimen/text_medium_size"
                android:textColor="@color/DarkGray"
                app:layout_constraintTop_toBottomOf="@+id/txt_id_card"
                app:layout_constraintStart_toEndOf="@+id/h_car"/>

        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/txt_reg_no"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:gravity="start"
                tools:text="CX-5674"
                android:textSize="@dimen/text_medium_size"
                android:textColor="@color/DarkGray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/m_reg_no"
                app:layout_constraintTop_toBottomOf="@+id/txt_id_card"/>


        <android.support.v7.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_book_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txt_unpaid_amt"
                android:id="@+id/h_unpaid"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/txt_unpaid_amt"/>

        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/m_unpaid_amt"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:gravity="start"
                android:textStyle="bold"
                android:text="@string/txtd_OVER_DUE_AMOUNT"
                android:textSize="@dimen/text_medium_size"
                android:textColor="@color/DarkGray"
                app:layout_constraintTop_toBottomOf="@+id/txt_reg_no"
                app:layout_constraintStart_toEndOf="@+id/h_car"/>

        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/txt_unpaid_amt"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:gravity="start"
                tools:text="0.0"
                android:textSize="@dimen/text_medium_size"
                android:textColor="@color/red"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toBottomOf="@+id/txt_reg_no"
                app:layout_constraintStart_toEndOf="@+id/m_unpaid_amt"/>


        <android.support.v7.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_book_red"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/h_unpaid_term"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/m_unpaid_term"
                app:layout_constraintTop_toTopOf="@+id/m_unpaid_term"/>

        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/m_unpaid_term"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:gravity="start"
                android:textStyle="bold"
                android:text="@string/txt_unpaid_term"
                android:textSize="@dimen/text_medium_size"
                android:textColor="@color/DarkGray"
                app:layout_constraintTop_toBottomOf="@+id/txt_unpaid_amt"
                app:layout_constraintStart_toEndOf="@+id/h_unpaid_term"/>

        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/txt_unpaid_term"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:gravity="start"
                tools:text="0.0"
                android:textSize="@dimen/text_medium_size"
                android:textColor="@color/red"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txt_unpaid_amt"
                app:layout_constraintStart_toEndOf="@+id/m_unpaid_term"/>


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/datetime"
            style="@style/Text_Bold_Small"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="end"
            tools:text="Date - Time"
            android:textColor="@color/DeepBlack"
            app:layout_constraintTop_toBottomOf="@+id/txt_custhouse_location_distance"
            android:layout_marginEnd="8dp" app:layout_constraintEnd_toEndOf="parent"/>

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_custhouse_location_distance"
            style="@style/Text_Bold_Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            tools:text="km."
            android:layout_marginEnd="8dp"
            android:textColor="@color/MidnightBlue"
            android:textSize="@dimen/text_large_size"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
    />




    <android.support.constraint.Barrier
        android:id="@+id/barrier_location_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:layout_constraintTop_toBottomOf="@+id/destination" />

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/custhouse_location_direction"
        style="@style/Text_Bold_Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_small"
        android:layout_marginTop="@dimen/margin_normal"
        android:drawablePadding="4dp"
        android:drawableRight="@drawable/route_ic"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="@string/location_direction"
        android:background="@drawable/selector_btn_confirm_green"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@+id/custhouse_location_set_work"
        app:layout_constraintTop_toBottomOf="@id/destination" />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/custhouse_location_set_work"
            style="@style/Text_Bold_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_normal"
            android:drawablePadding="4dp"
            android:drawableRight="@drawable/route_ic"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingLeft="20dp"
            android:paddingRight="15dp"
            android:text="@string/txt_work"
            android:background="@drawable/selector_btn_confirm_red"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/destination" />


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/custhouse_location_detail"
            style="@style/Text_Bold_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_normal"
            android:drawablePadding="4dp"
            android:paddingTop="5dp"
            android:gravity="right"
            android:paddingBottom="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/location_detail"
            android:drawableEnd="@drawable/ic_info_circle"
            android:background="@drawable/selector_btn_confirm_blue"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@id/custhouse_location_direction"
            app:layout_constraintTop_toBottomOf="@id/destination"
    />

</android.support.constraint.ConstraintLayout>