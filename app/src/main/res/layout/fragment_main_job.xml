<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Fragment.MainJobFragment">

    <!--<LinearLayout-->
            <!--android:id="@+id/linearLayout"-->
            <!--android:layout_width="0dp"-->
            <!--android:layout_height="0dp"-->
            <!--android:orientation="vertical"-->
            <!--app:layout_constraintBottom_toBottomOf="parent"-->
            <!--app:layout_constraintEnd_toEndOf="parent"-->
            <!--app:layout_constraintStart_toStartOf="parent"-->
            <!--app:layout_constraintTop_toTopOf="parent">-->

        <android.support.constraint.ConstraintLayout
                android:id="@+id/const1"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="0dp"
                android:background="@color/title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

        </android.support.constraint.ConstraintLayout>

        <android.support.v7.widget.AppCompatButton
                android:id="@+id/btn_all"
                style="@style/Text_Bold_Large"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/btn_map_all_job"
                android:text=""
                android:textAllCaps="false"
                android:textColor="@color/darkblue"
                android:textSize="@dimen/home_content_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/const1"
                app:layout_constraintBottom_toBottomOf="@+id/const1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
        />
        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/txtAlljob"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:text="JOB REQUEST"
                android:textAllCaps="false"
                android:textColor="@color/darkblue"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="@+id/btn_all"
                app:layout_constraintStart_toStartOf="@+id/btn_all"
                app:layout_constraintTop_toBottomOf="@+id/btn_all"/>

        <android.support.constraint.ConstraintLayout
                android:id="@+id/lay_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/white"
                android:paddingTop="@dimen/margin_20"
                app:layout_constraintTop_toBottomOf="@+id/txtAlljob">

            <com.tlt.georepo.view.TLTButton
                    android:id="@+id/btn_newjob"
                    style="@style/Text_Bold_Large"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="@dimen/margin_normal"
                    android:background="@drawable/select_job_menu_yellow"
                    android:padding="8dp"
                    android:paddingStart="@dimen/margin_normal"
                    android:paddingEnd="@dimen/margin_normal"
                    android:text="1"
                    android:textAllCaps="false"
                    android:textColor="@color/darkblue"
                    android:textSize="@dimen/home_content_margin_horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/lay_bottom"
                    app:layout_constraintEnd_toEndOf="@+id/btn_cancel"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/txt_job_yourjob"
                    android:textAllCaps="false"
                    android:textColor="@color/darkblue"
                    app:layout_constraintEnd_toStartOf="@+id/space_insurance_other"
                    app:layout_constraintHorizontal_bias="0.532"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_newjob" />

            <Space
                    android:id="@+id/space_installment_tax"
                    android:layout_width="@dimen/margin_normal"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toStartOf="@id/btn_onhand"
                    app:layout_constraintStart_toEndOf="@id/btn_newjob"
                    tools:ignore="MissingConstraints"/>

            <com.tlt.georepo.view.TLTButton
                    android:id="@+id/btn_onhand"
                    style="@style/Text_Bold_Large"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="36dp"
                    android:background="@drawable/select_job_menu_green"
                    android:padding="8dp"
                    android:text="1"
                    android:textAllCaps="false"
                    android:textColor="@color/darkblue"
                    android:textSize="@dimen/home_content_margin_horizontal"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/space_insurance_other"
                    app:layout_constraintStart_toStartOf="@+id/btn_waiting"
                    app:layout_constraintHorizontal_bias="0.0"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginTop="4dp"
                    android:text="ON HAND"
                    android:textAllCaps="false"
                    android:textColor="@color/darkblue"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="@+id/btn_onhand"
                    app:layout_constraintStart_toStartOf="@+id/btn_onhand"
                    app:layout_constraintTop_toBottomOf="@+id/btn_onhand"/>

            <com.tlt.georepo.view.TLTButton
                    android:id="@+id/btn_cancel"
                    style="@style/Text_Bold_Large"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="@dimen/margin_normal"
                    android:layout_marginTop="@dimen/margin_large"
                    android:background="@drawable/select_job_menu_red"
                    android:padding="8dp"
                    android:text="1"
                    android:textAllCaps="false"
                    android:textColor="@color/darkblue"
                    android:textSize="@dimen/home_content_margin_horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_onhand"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/space3"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="CANCEL"
                    android:textColor="@color/darkblue"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="@+id/btn_cancel"
                    app:layout_constraintTop_toBottomOf="@+id/btn_cancel"
                    app:layout_constraintEnd_toEndOf="@+id/btn_cancel"/>

            <Space
                    android:id="@+id/space_insurance_other"
                    android:layout_width="@dimen/margin_normal"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toStartOf="@id/btn_onhand"
                    app:layout_constraintStart_toEndOf="@id/btn_newjob"
                    tools:ignore="MissingConstraints"/>

            <com.tlt.georepo.view.TLTButton
                    android:id="@+id/btn_total"
                    style="@style/Text_Bold_Large"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="@dimen/margin_normal"
                    android:background="@drawable/select_job_menu_blue"
                    android:padding="8dp"
                    android:text="1"
                    android:textAllCaps="false"
                    android:textColor="@color/darkblue"
                    android:textSize="@dimen/home_content_margin_horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btn_cancel"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toStartOf="@+id/space3"/>


            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/txt_job_extension"
                    android:textColor="@color/darkblue"
                    app:layout_constraintStart_toStartOf="@+id/btn_total"
                    app:layout_constraintTop_toBottomOf="@+id/btn_total"
                    app:layout_constraintEnd_toEndOf="@+id/btn_total"/>

            <Space
                    android:id="@+id/space3"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/margin_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_waiting" />


        </android.support.constraint.ConstraintLayout>

        <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/const1"
                app:srcCompat="@drawable/logo_app" />

    <!--</LinearLayout>-->

</android.support.constraint.ConstraintLayout>