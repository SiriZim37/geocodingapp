<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              xmlns:card_view="http://schemas.android.com/apk/res-auto">

    <android.support.v7.widget.CardView
            android:id="@+id/card_view"
            style="@style/MyCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:clickable="true"
            android:onClick="showMapDetails"
            card_view:cardCornerRadius="1dp">

        <android.support.constraint.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <!--<android.support.v7.widget.AppCompatImageView-->
            <!--android:id="@+id/image"-->
            <!--android:layout_width="0dp"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:scaleType="fitCenter"-->
            <!--android:adjustViewBounds="true"-->
            <!--app:layout_constraintEnd_toEndOf="parent"-->
            <!--app:layout_constraintStart_toStartOf="parent"-->
            <!--app:layout_constraintTop_toTopOf="parent"-->
            <!--tools:srcCompat="@drawable/promobanner_1" />-->


            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/title"
                    style="@style/Text_Bold_Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_job_status_no"
                    android:padding="@dimen/padding_small"
                    android:paddingStart="@dimen/padding_normal"
                    android:paddingEnd="@dimen/padding_normal"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="No"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/title2"
                    style="@style/Text_Bold_Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_job_status"
                    android:padding="@dimen/padding_small"
                    android:paddingStart="@dimen/padding_normal"
                    android:paddingEnd="@dimen/padding_normal"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="STATUS" />

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/description"
                    style="@style/Text_Bold_Small"
                    android:layout_width="384dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    tools:text="Name"
                    android:padding="@dimen/padding_small"
                    android:textSize="20dp"
                    android:textColor="@color/DarkBlue"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/title"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toStartOf="parent"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/cancelDetail"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    tools:text="Calcel detail"
                    android:padding="@dimen/padding_xsmall"
                    android:textSize="18dp"
                    android:textColor="@color/DarkRed"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description"
                    android:layout_marginStart="8dp"/>



            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/locate"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="@dimen/margin_small"
                    android:gravity="start"
                    tools:text="location"
                    android:padding="@dimen/padding_xsmall"
                    android:textSize="20dp"
                    android:textColor="@color/DarkGray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cancelDetail"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/description2"
                    style="@style/Text_Bold_Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    tools:text="description"
                    android:padding="@dimen/padding_xsmall"
                    android:textSize="14dp"
                    android:textColor="@color/gray"
                   app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/title2"
                    app:layout_constraintStart_toEndOf="@+id/title"
                    android:layout_marginStart="8dp"/>

            <android.support.v7.widget.AppCompatTextView
                android:id="@+id/datetime"
                style="@style/Text_Bold_Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:gravity="end"
                tools:text="Date - Time"
                android:padding="@dimen/padding_small"
                android:textColor="@color/Goldenrod"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title" />


            <com.google.android.gms.maps.MapView
                    xmlns:map="http://schemas.android.com/apk/res-auto"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:id="@+id/map"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_below="@id/title"
                    map:liteMode="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    map:layout_constraintTop_toBottomOf="@+id/locate"/>


        </android.support.constraint.ConstraintLayout>

    </android.support.v7.widget.CardView>

</LinearLayout>

