<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             xmlns:app="http://schemas.android.com/apk/res-auto"
                                             xmlns:tools="http://schemas.android.com/tools"
                                             android:layout_width="match_parent"
                                             android:layout_height="match_parent">

    <android.support.v4.widget.NestedScrollView
            android:id="@+id/nestedscrollview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_normal"
                android:orientation="vertical">

            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.CardView
                            style="@style/MyCardView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp">

                        <android.support.constraint.ConstraintLayout
                                android:id="@+id/top_layout"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="@dimen/margin_normal"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp">

                            <android.support.constraint.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:id="@+id/txt_top_customer">
                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="8dp"
                                        android:fontFamily="@font/custom_bold"
                                        android:gravity="center_vertical"
                                        android:includeFontPadding="false"
                                        android:textColor="#b3b3b3"
                                        android:textSize="15sp"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        tools:text="11 ม.ค. 2561" />


                                <android.support.v7.widget.AppCompatImageView
                                        android:id="@+id/cust_profile"
                                        android:layout_width="120dp"
                                        android:layout_height="120dp"
                                        android:layout_marginTop="@dimen/margin_12"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:srcCompat="@drawable/ic_person_black_24dp"
                                        app:layout_constraintTop_toBottomOf="@+id/txt_date"/>

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_cust_type"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        android:text="(ผู้เช่าซื้อ)"
                                        android:layout_marginEnd="8dp"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        android:layout_marginTop="8dp"
                                        app:layout_constraintTop_toBottomOf="@+id/txt_cust_name"
                                        app:layout_constraintStart_toStartOf="@+id/txt_cust_name"/>


                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_cust_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="8dp"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:text="@string/txtCustName"
                                        android:textColor="@color/text_normal"
                                        android:textSize="@dimen/text_large_size"
                                        app:layout_constraintStart_toEndOf="@id/cust_profile"
                                        app:layout_constraintTop_toTopOf="@+id/cust_profile"/>


                                <android.support.v7.widget.AppCompatImageView
                                        android:id="@+id/m_idcard"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        app:srcCompat="@drawable/ic_id_card"
                                        app:layout_constraintTop_toTopOf="@+id/h_idcard"
                                        app:layout_constraintBottom_toBottomOf="@+id/h_idcard"
                                        app:layout_constraintEnd_toStartOf="@+id/h_idcard"
                                        android:layout_marginEnd="8dp"
                                        app:layout_constraintStart_toStartOf="parent"
                                />

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/h_idcard"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:gravity="left"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        android:text="@string/id_card"
                                        android:layout_marginStart="8dp"
                                        app:layout_constraintStart_toEndOf="@id/m_idcard"
                                        android:layout_marginTop="8dp"
                                        app:layout_constraintTop_toBottomOf="@+id/cust_profile"/>


                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_id_card"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:gravity="right"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        android:text="1100405500606"
                                        android:layout_marginEnd="8dp"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="@+id/h_idcard"
                                        app:layout_constraintStart_toEndOf="@+id/h_idcard"
                                        android:layout_marginStart="8dp"/>


                                <android.support.v7.widget.AppCompatImageView
                                        android:id="@+id/m_address"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        app:srcCompat="@drawable/ic_map"
                                        app:layout_constraintTop_toTopOf="@+id/h_address"
                                        app:layout_constraintBottom_toBottomOf="@+id/h_address"
                                        app:layout_constraintStart_toStartOf="parent"/>

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/h_address"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:gravity="left"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        app:layout_constraintTop_toBottomOf="@+id/txt_id_card"
                                        android:text="@string/txtAddress"
                                        android:layout_marginTop="8dp"
                                        android:layout_marginStart="8dp"
                                        app:layout_constraintStart_toEndOf="@id/m_address"
                                />


                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_real_address"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="right"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        android:text="99/8 Aubdulrahim Bangruk 30140"
                                        app:layout_constraintTop_toTopOf="@+id/h_address"
                                        app:layout_constraintStart_toEndOf="@+id/h_address"
                                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                                        app:layout_constraintEnd_toEndOf="parent"/>


                                <android.support.v7.widget.AppCompatImageView
                                        android:id="@+id/m_tel"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        app:srcCompat="@drawable/ic_phone_orange"
                                        app:layout_constraintTop_toTopOf="@+id/h_tel"
                                        app:layout_constraintBottom_toBottomOf="@+id/h_tel"
                                        app:layout_constraintEnd_toStartOf="@+id/h_tel"
                                        android:layout_marginEnd="8dp"
                                        app:layout_constraintStart_toStartOf="parent"
                                />

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/h_tel"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:gravity="left"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        android:text="@string/mobile"
                                        android:layout_marginTop="8dp"
                                        android:layout_marginStart="8dp"
                                        app:layout_constraintStart_toEndOf="@id/m_tel"
                                        app:layout_constraintTop_toBottomOf="@+id/txt_real_address"/>

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_mobile_phone"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="right"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:textColor="@color/Blue"
                                        android:textSize="@dimen/car_contract_text_content"
                                        android:text="-"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="@+id/h_tel"
                                        app:layout_constraintStart_toEndOf="@+id/h_tel"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginEnd="8dp"/>


                                <android.support.v7.widget.AppCompatImageView
                                        android:id="@+id/m_tel_home"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        app:srcCompat="@drawable/ic_contactus_phone"
                                        app:layout_constraintTop_toTopOf="@+id/h_tel_home"
                                        app:layout_constraintBottom_toBottomOf="@+id/h_tel_home"
                                        app:layout_constraintEnd_toStartOf="@+id/h_tel_home"
                                        android:layout_marginEnd="8dp"
                                        app:layout_constraintStart_toStartOf="parent"
                                />

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/h_tel_home"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:gravity="left"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        app:layout_constraintTop_toBottomOf="@+id/txt_mobile_phone"
                                        android:text="@string/Telephone"
                                        android:layout_marginTop="8dp"
                                        android:layout_marginStart="8dp"
                                        app:layout_constraintStart_toEndOf="@id/m_tel_home"
                                />

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_mobile_home"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="right"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:textColor="@color/Blue"
                                        android:textSize="@dimen/car_contract_text_content"
                                        android:text="-"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="@+id/h_tel_home"
                                        app:layout_constraintStart_toEndOf="@+id/h_tel_home"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginEnd="8dp"/>





                            </android.support.constraint.ConstraintLayout>
                        </android.support.constraint.ConstraintLayout>
                    </android.support.v7.widget.CardView>
                </FrameLayout>

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.AppCompatImageView
                            android:id="@+id/ic_car_contract"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_gravity="top|center_horizontal"
                            app:srcCompat="@drawable/top_history_menu" />
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                    android:id="@+id/layout_contractdetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_12">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.CardView
                            style="@style/MyCardView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="0dp">

                        <android.support.constraint.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:paddingBottom="8dp"
                                android:paddingTop="@dimen/margin_large"
                                android:background="@color/white">


                            <android.support.v7.widget.RecyclerView
                                    android:id="@+id/recycler_view"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    tools:listitem="@layout/item_collection_remark"
                                    android:layout_marginTop="8dp"
                                    app:layout_constraintTop_toTopOf="parent"/>


                        </android.support.constraint.ConstraintLayout>
                    </android.support.v7.widget.CardView>
                </FrameLayout>

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.AppCompatTextView
                            android:id="@+id/tag_contract_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_tag_header"
                            android:fontFamily="@font/custom_bold"
                            android:includeFontPadding="false"
                            android:text="@string/guarantor_h"
                            android:textColor="@color/white"
                            android:textSize="20sp" />
                </FrameLayout>
            </FrameLayout>


            <FrameLayout
                    android:id="@+id/layout_contract_the_dealer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_normal">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.CardView
                            style="@style/MyCardView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="0dp">

                        <com.google.android.gms.maps.MapView
                                xmlns:map="http://schemas.android.com/apk/res-auto"
                                android:name="com.google.android.gms.maps.SupportMapFragment"
                                android:id="@+id/map"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:layout_below="@id/title"
                                map:liteMode="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                map:layout_constraintTop_toBottomOf="@+id/locate"/>

                    </android.support.v7.widget.CardView>
                </FrameLayout>

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.AppCompatTextView
                            android:id="@+id/tag_contract_the_dealer"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_tag_header"
                            android:fontFamily="@font/custom_bold"
                            android:includeFontPadding="false"
                            android:text="@string/location"
                            android:textColor="@color/white"
                            android:textSize="20sp" />
                </FrameLayout>
            </FrameLayout>

            <Space
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>
</android.support.constraint.ConstraintLayout>