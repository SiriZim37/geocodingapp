<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:clickable="true"
        android:foreground="?selectableItemBackgroundBorderless"
        android:padding="16dp"
        android:background="@color/white"
        android:layout_height="wrap_content">

    <android.support.v7.widget.AppCompatImageView
            android:id="@+id/icon_front"
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_home" />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/tv"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/custom_regular"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:text="ค่างวดรถยนต์"
            android:textColor="@color/sidebar_menu_title"
            android:textSize="@dimen/text_medium_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_front"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="menu"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"/>




</android.support.constraint.ConstraintLayout>