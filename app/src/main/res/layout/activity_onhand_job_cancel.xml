<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             xmlns:app="http://schemas.android.com/apk/res-auto"
                                             xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                                             android:layout_height="match_parent">

    <com.tlt.georepo.view.ToolbarWidget
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/title_cancel_menu"
            app:toolbarSize="normal" />

    <android.support.v4.widget.NestedScrollView
            android:id="@+id/nestedscrollview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_normal"
                android:orientation="vertical">

            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.CardView
                            style="@style/MyCardView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp">

                        <android.support.constraint.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="47dp"
                                android:orientation="vertical">

                            <android.support.v7.widget.AppCompatTextView
                                    android:id="@+id/title_reason"
                                    style="@style/Text_Bold_Large"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/form_job_margin"
                                    android:layout_marginTop="@dimen/margin_normal"
                                    android:layout_marginEnd="@dimen/form_job_margin"
                                    android:gravity="start"
                                    android:text="@string/txt_reason"
                                    android:textColor="@color/black"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />


                            <com.tlt.georepo.view.SpinnerView
                                    android:id="@+id/spinner_data_cancel"
                                    style="@style/Widget.AppCompat.Spinner.Underlined"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/form_job_margin"
                                    android:layout_marginEnd="@dimen/form_job_margin"
                                    app:hint="@string/question_and_answer_topic_hint"
                                    app:layout_constraintEnd_toEndOf="@id/title_reason"
                                    app:layout_constraintStart_toStartOf="@id/title_reason"
                                    app:layout_constraintTop_toBottomOf="@id/title_reason"/>


                            <android.support.v7.widget.AppCompatTextView
                                    android:id="@+id/title_detail"
                                    style="@style/Text_Bold_Large"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/form_job_margin"
                                    android:layout_marginTop="@dimen/margin_normal"
                                    android:layout_marginEnd="@dimen/form_job_margin"
                                    android:gravity="start"
                                    android:text="@string/txt_comment_reason"
                                    android:textColor="@color/black"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/spinner_data_cancel" />

                            <com.tlt.georepo.view.OwaspEditText
                                    android:id="@+id/edittext_detail"
                                    style="@style/Text_Bold_Large"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_edittext"
                                    android:gravity="top"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:lines="4"
                                    android:maxLines="4"
                                    android:textColor="@color/brownish_grey"
                                    app:layout_constraintEnd_toEndOf="@id/title_detail"
                                    app:layout_constraintStart_toStartOf="@id/title_detail"
                                    app:layout_constraintTop_toBottomOf="@id/title_detail" />

                            <android.support.v7.widget.AppCompatButton
                                    android:id="@+id/btn_confirm"
                                    style="@style/Button_Reject"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/form_job_margin"
                                    android:layout_marginEnd="@dimen/form_job_margin"
                                    android:text="Confirm"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    android:layout_marginTop="8dp"
                                    app:layout_constraintTop_toBottomOf="@+id/edittext_detail"/>

                            <android.support.constraint.Barrier
                                    android:id="@+id/barrier_btn_confirm"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:barrierDirection="bottom"
                                    app:constraint_referenced_ids="btn_confirm" />

                            <Space
                                    android:layout_width="0dp"
                                    android:layout_height="29dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/barrier_btn_confirm"/>

                         </android.support.constraint.ConstraintLayout>
                    </android.support.v7.widget.CardView>
                </FrameLayout>

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.AppCompatImageView
                            android:id="@+id/ic_car_contract"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_gravity="top|center_horizontal"
                            app:srcCompat="@drawable/top_history_menu" />
                </FrameLayout>
            </FrameLayout>

            <Space
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/margin_large" />
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>
</android.support.constraint.ConstraintLayout>