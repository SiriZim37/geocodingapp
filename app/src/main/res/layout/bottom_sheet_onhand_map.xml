<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/map_bottom_sheet_onhand_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="false"
    app:behavior_peekHeight="200dp">

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/map_bottom_sheet_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:srcCompat="@drawable/bg_metal" />

    <android.support.v7.widget.CardView
        style="@style/MyCardView_Margin_Normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.tlt.georepo.view.TLTTextView
                android:id="@+id/location_map_company_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="5dp"
                android:paddingRight="2dp"
                android:background="@color/title"
                android:fontFamily="@font/rsu_bold"
                android:textColor="@color/white"
                android:textSize="@dimen/text_medium_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/job_ontheway" />

            <com.tlt.georepo.view.TLTTextView
                    android:id="@+id/location_map_company_tv2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingLeft="5dp"
                    android:paddingRight="2dp"
                    android:fontFamily="@font/rsu_bold"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_medium_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/location_map_company_tv"
                    app:layout_constraintTop_toTopOf="parent"/>

            <!--<android.support.v7.widget.AppCompatTextView-->
                    <!--android:id="@+id/txtname"-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="0dp"-->
                    <!--android:padding="4dp"-->
                    <!--android:text="Name"-->
                    <!--android:textColor="@color/darkblue"-->
                    <!--android:textSize="@dimen/text_small_size"-->
                    <!--app:layout_constraintStart_toStartOf="parent"-->
                    <!--app:layout_constraintTop_toBottomOf="@+id/location_map_company_tv"/>-->

            <!--<android.support.v7.widget.AppCompatTextView-->
                    <!--android:id="@+id/txtlocation"-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="0dp"-->
                    <!--android:padding="4dp"-->
                    <!--android:textColor="@color/darkblue"-->
                    <!--android:text="Location "-->
                    <!--android:textSize="@dimen/text_small_size"-->
                    <!--app:layout_constraintStart_toStartOf="parent"-->
                    <!--app:layout_constraintTop_toBottomOf="@+id/txtname"/>-->

            <android.support.v7.widget.AppCompatImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/cust_info"
                    android:elevation="5dp"
                    app:layout_constraintEnd_toEndOf="@+id/btnCustomerDetail"
                    app:layout_constraintTop_toTopOf="@+id/btnCustomerDetail"
                    app:layout_constraintStart_toStartOf="@+id/btnCustomerDetail"
                    app:layout_constraintBottom_toTopOf="@+id/appCompatTextView2"/>

            <android.support.v7.widget.AppCompatButton
                    android:id="@+id/btnCustomerDetail"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle_green"
                    android:fontFamily="@font/custom_bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginRight="10dp"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_small_size"
                    app:layout_constraintTop_toBottomOf="@+id/location_map_company_tv"
                    app:layout_constraintEnd_toStartOf="@+id/btnEstTime"/>

            <android.support.v7.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onhand_details"
                    android:textColor="@color/darkblue"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/btnCustomerDetail"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/custom_regular"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/btnCustomerDetail"
                    app:layout_constraintStart_toStartOf="@+id/btnCustomerDetail"
                    android:id="@+id/appCompatTextView2"/>


            <android.support.v7.widget.AppCompatButton
                    android:id="@+id/btnEstTime"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_blue"
                    android:fontFamily="@font/custom_bold"
                    android:layout_marginRight="5dp"
                    android:layout_margin="10dp"
                    text="30 min"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_small_size"
                    app:layout_constraintTop_toBottomOf="@+id/location_map_company_tv2"
                    app:layout_constraintEnd_toStartOf="@+id/divider"/>


            <android.support.v7.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onhand_time"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/btnCustomerDetail"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/darkblue"
                    android:fontFamily="@font/custom_regular"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/btnEstTime"
                    app:layout_constraintStart_toStartOf="@+id/btnEstTime"/>


            <View
                    android:id="@+id/divider"
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:fontFamily="@font/custom_bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            <android.support.v7.widget.AppCompatButton
                    android:id="@+id/btnEstDistance"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_circle_faq_detail"
                    android:fontFamily="@font/custom_bold"
                    android:layout_marginBottom="5dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="10dp"
                    text="1 km"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_small_size"
                    app:layout_constraintStart_toEndOf="@+id/divider"
                    app:layout_constraintTop_toBottomOf="@+id/location_map_company_tv2"/>


            <android.support.v7.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onhand_distant"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/btnCustomerDetail"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/custom_regular"
                    android:textColor="@color/darkblue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/btnEstDistance"
                    app:layout_constraintStart_toStartOf="@+id/btnEstDistance"/>


            <android.support.v7.widget.AppCompatImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/streetview_icon2"
                    android:elevation="5dp"
                    app:layout_constraintEnd_toEndOf="@+id/btnNavigator"
                    app:layout_constraintStart_toStartOf="@+id/btnNavigator"
                    app:layout_constraintBottom_toTopOf="@+id/appCompatTextView"
                    app:layout_constraintTop_toTopOf="@+id/btnNavigator"/>
            <android.support.v7.widget.AppCompatButton
                    android:id="@+id/btnNavigator"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle_green"
                    android:fontFamily="@font/custom_bold"
                    android:gravity="center"
                    android:layout_marginBottom="5dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_small_size"
                    app:layout_constraintTop_toBottomOf="@+id/location_map_company_tv2"
                    app:layout_constraintStart_toEndOf="@+id/btnEstDistance"
            />
            <android.support.v7.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onhand_route"
                    android:fontFamily="@font/custom_regular"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/btnCustomerDetail"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/darkblue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/btnNavigator"
                    app:layout_constraintStart_toStartOf="@+id/btnNavigator"
                    android:id="@+id/appCompatTextView"/>





        </android.support.constraint.ConstraintLayout>
    </android.support.v7.widget.CardView>
</android.support.constraint.ConstraintLayout>