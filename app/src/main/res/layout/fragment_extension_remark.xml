<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             xmlns:app="http://schemas.android.com/apk/res-auto"
                                             xmlns:tools="http://schemas.android.com/tools"
                                             android:layout_width="match_parent"
                                             android:layout_height="match_parent">

    <android.support.v4.widget.NestedScrollView
            android:id="@+id/nestedscrollview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_normal"
                android:orientation="vertical">

            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.CardView
                            style="@style/MyCardView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp">

                        <android.support.constraint.ConstraintLayout
                                android:id="@+id/top_layout"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="@dimen/margin_normal"
                                android:paddingStart="10dp"
                                android:paddingEnd="20dp">

                            <android.support.constraint.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:id="@+id/txt_top_customer">
                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="8dp"
                                        android:fontFamily="@font/custom_bold"
                                        android:gravity="center_vertical"
                                        android:includeFontPadding="false"
                                        android:textColor="#b3b3b3"
                                        android:textSize="15sp"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        tools:text="11 ม.ค. 2561" />

                                <android.support.v7.widget.AppCompatImageView
                                        android:id="@+id/icon_type"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:layout_marginTop="47dp"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:srcCompat="@drawable/ic_fle" />

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_cust_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="8dp"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:text="@string/txtCustName"
                                        android:textColor="@color/text_normal"
                                        android:textSize="@dimen/text_large_size"
                                        app:layout_constraintStart_toEndOf="@id/icon_type"
                                        app:layout_constraintTop_toTopOf="@id/icon_type" />

                                <android.support.v7.widget.AppCompatTextView
                                        android:id="@+id/txt_reg_no"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/custom_bold"
                                        android:includeFontPadding="false"
                                        android:textColor="@color/text_disable"
                                        android:textSize="@dimen/car_contract_text_content"
                                        app:layout_constraintStart_toStartOf="@id/txt_cust_name"
                                        app:layout_constraintTop_toBottomOf="@id/txt_cust_name"
                                        android:text="กต - 1528 กรุงเทพมหานคร"
                                        tools:text="กต - 1528 กรุงเทพมหานคร" />


                            </android.support.constraint.ConstraintLayout>

                        </android.support.constraint.ConstraintLayout>


                    </android.support.v7.widget.CardView>


                </FrameLayout>


                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.AppCompatImageView
                            android:id="@+id/ic_car_contract"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_gravity="top|center_horizontal"
                            app:srcCompat="@drawable/top_history_menu" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                    android:id="@+id/layout_contractdetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_12">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.CardView
                            style="@style/MyCardView"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="0dp">

                        <android.support.constraint.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:paddingBottom="8dp"
                                android:paddingTop="@dimen/margin_large"
                                android:background="@color/white">


                            <android.support.v7.widget.RecyclerView
                                    android:id="@+id/recycler_view"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    tools:listitem="@layout/item_collection_remark"
                                    android:layout_marginTop="8dp"
                                    app:layout_constraintTop_toTopOf="parent"/>

                            <!--<include-->
                            <!--android:id="@+id/fragment_collection_remark_list"-->
                            <!--layout="@layout/fragment_collection_remark_list"-->
                            <!--android:layout_width="0dp"-->
                            <!--android:layout_height="wrap_content"-->
                            <!--app:layout_constraintEnd_toEndOf="parent"-->
                            <!--app:layout_constraintStart_toStartOf="parent"-->
                            <!--app:layout_constraintTop_toTopOf="parent"/>-->


                        </android.support.constraint.ConstraintLayout>
                    </android.support.v7.widget.CardView>
                </FrameLayout>

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <android.support.v7.widget.AppCompatTextView
                            android:id="@+id/tag_contract_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_tag_header"
                            android:fontFamily="@font/custom_bold"
                            android:includeFontPadding="false"
                            android:text="@string/follow_up"
                            android:textColor="@color/white"
                            android:textSize="20sp" />
                </FrameLayout>
            </FrameLayout>


            <Space
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>
</android.support.constraint.ConstraintLayout>