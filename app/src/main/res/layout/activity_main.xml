<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
        <android.support.v7.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@drawable/bg_toolbar_medium"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                app:layout_constraintTop_toTopOf="parent"
                android:elevation="5dp"/>
        <!--<georepoew.ToolbarWidget-->
        <!--android:id="@+id/toolbar"-->
        <!--android:layout_width="match_parent"-->
        <!--android:layout_height="50dp"-->
        <!--app:layout_constraintEnd_toEndOf="parent"-->
        <!--app:layout_constraintStart_toStartOf="parent"-->
        <!--app:layout_constraintTop_toTopOf="parent"-->
        <!--app:navigationIcon="@drawable/ic_menubars"-->
        <!--app:title="@string/repoHome"-->
        <!--app:toolbarSize="medium" />-->


        <com.tlt.georepo.view.NotificationWidget
                android:id="@+id/btn_notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/toolbar"
                app:layout_constraintBottom_toBottomOf="@+id/toolbar"
                android:elevation="5dp"/>

        <TextView
                android:id="@+id/tv_nav_drawer_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_circle_green"
                android:text="1"
                android:gravity="center"
                android:textColor="@android:color/white"
                app:layout_constraintTop_toTopOf="@+id/btn_notification"
                app:layout_constraintRight_toRightOf="@+id/btn_notification"
                android:textSize="@dimen/text_medium_size"
                android:elevation="5dp"/>


        <android.support.constraint.ConstraintLayout
                android:id="@+id/lay_unverify"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@color/color_white"
                android:elevation="5dp">

            <android.support.constraint.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/lay_unverify"
                    app:layout_constraintBottom_toBottomOf="@+id/lay_unverify"
                    app:layout_constraintStart_toStartOf="@+id/lay_unverify"
                    app:layout_constraintEnd_toEndOf="@+id/lay_unverify">


                <ImageView
                        android:id="@+id/ic_lock"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:elevation="5dp"
                        android:src="@drawable/ic_lock4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>


                <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:srcCompat="@drawable/logo_app"
                        android:layout_marginBottom="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                />
                <android.support.v7.widget.AppCompatTextView
                        android:id="@+id/text_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_unverify"
                        android:paddingEnd="@dimen/margin_xlarge"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:fontFamily="@font/rsu_regular"
                        app:layout_constraintTop_toBottomOf="@id/ic_lock"
                        android:gravity="center"
                        android:textSize="@dimen/text_large_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                <android.support.v7.widget.AppCompatTextView
                        android:visibility="visible"
                        android:id="@+id/text_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_time"
                        android:paddingEnd="@dimen/margin_xlarge"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:fontFamily="@font/rsu_regular"
                        app:layout_constraintTop_toBottomOf="@id/text_status"
                        android:gravity="center"
                        android:textColor="@color/blood_red"
                        android:textSize="@dimen/text_xxlarge_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                <Button
                        android:id="@+id/bt_checkApproval"
                        android:layout_width="210dp"
                        android:text="@string/txt_check_status_approval"
                        android:fontFamily="@font/rsu_regular"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_large_size"
                        android:layout_height="wrap_content"
                        android:textAllCaps="false"
                        app:layout_constraintTop_toBottomOf="@+id/text_time"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@drawable/btn_teal"
                        android:layout_marginTop="@dimen/margin_medium"/>
            </android.support.constraint.ConstraintLayout>

        </android.support.constraint.ConstraintLayout>


        <FrameLayout
                android:id="@+id/layout_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                tools:background="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@+id/toolbar"
                app:layout_constraintBottom_toBottomOf="parent"
        />

    </android.support.constraint.ConstraintLayout>


    <android.support.design.widget.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="start">

        <com.tlt.georepo.view.SidebarMenuWidget
                android:id="@+id/layout_sidebar_menu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>


    </android.support.design.widget.NavigationView>
</android.support.v4.widget.DrawerLayout>


