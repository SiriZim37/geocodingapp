<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/margin_normal">


    <android.support.v7.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_person_black_24dp"
            android:id="@+id/h_human"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toTopOf="@+id/cust_name"
             app:layout_constraintBottom_toBottomOf="@+id/txt_cust_name"/>

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_cust_name"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:gravity="start"
            android:layout_height="wrap_content"
            android:textColor="@color/DarkBlue"
            app:layout_constraintHorizontal_weight="4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txt_custhouse_location_distance"
            tools:text="นาย เทส ระบบ"
            app:layout_constraintStart_toEndOf="@+id/h_human"
            android:layout_marginStart="2dp"/>

    <android.support.v7.widget.AppCompatImageView
            android:id="@+id/m_con_no"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/ic_car_contract"
            app:layout_constraintTop_toTopOf="@+id/txt_cust_no_and_type_cust"
            app:layout_constraintBottom_toBottomOf="@+id/txt_cust_no_and_type_cust"
            app:layout_constraintEnd_toStartOf="@+id/txt_cust_no_and_type_cust"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
    />


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_cust_no_and_type_cust"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:gravity="start"
            android:layout_height="wrap_content"
            android:textColor="@color/DarkRed"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="AHP111111 ( customer )"
            app:layout_constraintStart_toEndOf="@+id/h_human"
            android:layout_marginStart="2dp" app:layout_constraintTop_toBottomOf="@+id/txt_cust_name"/>

    <android.support.v7.widget.AppCompatTextView
        android:id="@+id/txt_custhouse_location_distance"
        style="@style/Text_Bold_Small"
        android:layout_width="wrap_content"
        android:textSize="20dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        app:layout_constraintHorizontal_weight="1"
        android:textColor="@color/red"
        app:layout_constraintStart_toEndOf="@id/txt_cust_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="0.0 กม." />

    <android.support.constraint.Barrier
        android:id="@+id/barrier_name_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="txt_cust_name,txt_custhouse_location_distance,txt_cust_no_and_type_cust"
        app:barrierDirection="bottom"/>


    <android.support.v7.widget.AppCompatImageView
            android:id="@+id/m_car"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/ic_car"
            app:layout_constraintTop_toTopOf="@+id/txt_reg_no"
            app:layout_constraintBottom_toBottomOf="@+id/txt_reg_no"
            app:layout_constraintEnd_toStartOf="@+id/txt_reg_no"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
    />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_reg_no"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/text_medium_size"
            android:layout_marginStart="2dp"
            android:textColor="@color/DarkGray"
            app:layout_constraintStart_toEndOf="@+id/m_car"
            app:layout_constraintTop_toBottomOf="@id/txt_cust_no_and_type_cust"
            tools:text="AX-345" />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txtcarModelColor"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/text_medium_size"
            android:textColor="@color/DarkGray"
            tools:text="( Model/Color ) "
            app:layout_constraintStart_toEndOf="@+id/txt_reg_no"
            android:layout_marginStart="8dp" tools:layout_editor_absoluteY="46dp"/>


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/h_inst_amt"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/text_medium_size"
            android:text="@string/txtD_OVER_DUE_AMOUNT"
            android:textColor="@color/DarkGray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_reg_no"
           />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_inst_amt"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/text_medium_size"
            android:layout_marginStart="8dp"
            android:textColor="@color/red"
            app:layout_constraintStart_toEndOf="@+id/h_inst_amt"
            app:layout_constraintTop_toBottomOf="@id/txt_reg_no"
            tools:text="0" />


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/h_unpaid_term"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/text_medium_size"
            android:textColor="@color/DarkGray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_inst_amt"
            android:text="@string/txt_unpaid_amt" />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/h_overd_day"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/text_medium_size"
            android:textColor="@color/DarkGray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/h_unpaid_term"
            android:text="@string/txt_over_day" />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_overdue_day"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:layout_marginStart="8dp"
            android:textColor="@color/red"
            android:textSize="@dimen/text_medium_size"
            app:layout_constraintStart_toEndOf="@+id/h_overd_day"
            app:layout_constraintTop_toBottomOf="@id/txt_unpaid_term"
            tools:text="0" />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_unpaid_term"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:layout_marginStart="8dp"
            android:textColor="@color/red"
            android:textSize="@dimen/text_medium_size"
            app:layout_constraintStart_toEndOf="@+id/h_unpaid_term"
            app:layout_constraintTop_toBottomOf="@id/txt_inst_amt"
            tools:text="0" />



    <android.support.v7.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_pin_orange"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/h_location"

            app:layout_constraintTop_toTopOf="@+id/txt_cust_address"/>

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_cust_address"
            style="@style/Text_Bold_Medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/text_medium_size"
            android:textColor="@color/text_normal_lighter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/h_location"
            app:layout_constraintTop_toBottomOf="@id/h_overd_day"
            android:layout_marginStart="2dp"
            tools:text="ถนนพหลโยธิน เขต จตุจักร กรุงเทพ"/>

    <android.support.constraint.Barrier
        android:id="@+id/barrier_location_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="txt_cust_address" />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/custhouse_location_direction"
            style="@style/Text_Bold_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:drawableRight="@drawable/route_ic"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/location_direction"
            android:background="@drawable/selector_btn_confirm_green"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@+id/txt_cust_address"/>

    <!--<android.support.v7.widget.AppCompatTextView-->
        <!--android:id="@+id/custhouse_location_tel"-->
        <!--style="@style/Text_Bold_Medium"-->
        <!--android:layout_width="wrap_content"-->
        <!--android:layout_height="wrap_content"-->
        <!--android:layout_marginEnd="@dimen/margin_large"-->
        <!--android:layout_marginTop="@dimen/margin_normal"-->
        <!--android:drawablePadding="4dp"-->
        <!--android:drawableStart="@drawable/ic_phone_green"-->
        <!--android:text="@string/location_tel"-->
        <!--android:textColor="@color/teal_500"-->
        <!--app:layout_constraintEnd_toStartOf="@id/custhouse_location_direction"-->
        <!--app:layout_constraintTop_toBottomOf="@id/barrier_location_address" />-->

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/custhouse_location_detail"
            style="@style/Text_Bold_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_medium"
            android:layout_marginTop="8dp"
            android:drawablePadding="4dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/location_detail"
            android:drawableEnd="@drawable/ic_info_circle"
            android:background="@drawable/selector_btn_confirm_blue"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@id/custhouse_location_direction"
            app:layout_constraintTop_toBottomOf="@+id/txt_cust_address"/>

</android.support.constraint.ConstraintLayout>