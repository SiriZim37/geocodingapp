    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/custhouse_location_detail"
            style="@style/Text_Bold_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/location_detail"
            android:drawableEnd="@drawable/ic_info_circle"
            android:background="@drawable/selector_btn_confirm_blue"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/titleStatus" android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/custhouse_location_set_complete"/>

</android.support.constraint.ConstraintLayout>