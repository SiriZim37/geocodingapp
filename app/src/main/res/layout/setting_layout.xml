<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Fragment.SettingsFragment">

    <ImageView
            android:id="@+id/imageView4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/cherry_red"
            app:layout_constraintBottom_toTopOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    <android.support.constraint.Guideline
            android:id="@+id/guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.2"/>

    <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageView_upper"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline"
            app:layout_constraintBottom_toBottomOf="@id/guideline"
            android:background="@drawable/ic_profile"/>

    <android.support.constraint.ConstraintLayout
            android:id="@+id/layout_settings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView4"
            app:layout_constraintBottom_toBottomOf="parent">

        <android.support.constraint.ConstraintLayout
                android:id="@+id/ln_info"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="@id/layout_settings"
                app:layout_constraintTop_toTopOf="@+id/layout_settings"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginRight="@dimen/margin_normal"
                android:layout_marginTop="@dimen/margin_xxlarge"
                android:background="@drawable/white_corner_radius"
        >

        </android.support.constraint.ConstraintLayout>


        <android.support.constraint.ConstraintLayout
                android:id="@+id/ln_profile"
                android:layout_width="match_parent"
                android:visibility="visible"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/layout_settings"
                app:layout_constraintEnd_toEndOf="@id/layout_settings"
                app:layout_constraintTop_toBottomOf="@+id/ln_info"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginRight="@dimen/margin_normal"
                android:paddingBottom="@dimen/margin_normal"
                android:background="@drawable/bg_white_corner_radius"
        >

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_name_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/margin_normal"
                    android:paddingTop="@dimen/margin_normal"
                    android:textSize="@dimen/text_large_size"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/Name"
                    android:paddingRight="8dp"
                    app:layout_constraintTop_toTopOf="@id/ln_profile"
                    app:layout_constraintStart_toStartOf="@+id/ln_profile"
            />

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="@font/custom_regular"
                    android:textSize="@dimen/text_large_size"
                    android:paddingTop="@dimen/margin_normal"
                    app:layout_constraintTop_toTopOf="@id/ln_profile"
                    android:gravity="end"
                    android:paddingRight="@dimen/margin_medium"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintStart_toEndOf="@+id/tv_name_header"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"/>
            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_email_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/margin_normal"
                    android:paddingTop="@dimen/margin_small"
                    android:textSize="@dimen/text_large_size"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/Email"
                    android:paddingRight="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name"
                    app:layout_constraintStart_toStartOf="@+id/ln_profile"

                    android:layout_marginTop="8dp"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="@font/custom_regular"
                    android:textSize="@dimen/text_large_size"
                    android:gravity="end"
                    android:paddingTop="@dimen/margin_small"
                    android:paddingRight="@dimen/margin_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@+id/tv_email_header"
                    app:layout_constraintTop_toTopOf="@+id/tv_email_header"/>

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_tel_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/margin_normal"
                    android:paddingTop="@dimen/margin_small"
                    android:textSize="@dimen/text_large_size"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/Telephone"
                    android:paddingRight="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_email"
                    app:layout_constraintStart_toStartOf="@+id/ln_profile"

                    android:layout_marginTop="8dp"/>
            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_tel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="@font/custom_regular"
                    android:textSize="@dimen/text_large_size"
                    android:paddingTop="@dimen/margin_small"
                    app:layout_constraintTop_toBottomOf="@id/tv_email"
                    android:gravity="end"
                    android:layout_marginTop="@dimen/margin_small"
                    android:paddingRight="@dimen/margin_medium"
                    android:layout_marginEnd="8dp" app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_tel_header"
                    android:layout_marginStart="16dp"/>
            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_company_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/margin_normal"
                    android:paddingTop="@dimen/margin_small"
                    android:paddingRight="8dp"
                    android:textSize="@dimen/text_large_size"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/Company"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tel"
                    app:layout_constraintStart_toStartOf="@+id/ln_profile"

                    android:layout_marginTop="8dp"/>


            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_com"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="@font/custom_regular"
                    android:textSize="@dimen/text_large_size"
                    app:layout_constraintTop_toBottomOf="@id/tv_tel"
                    android:gravity="end"
                    android:paddingTop="@dimen/margin_small"
                    android:layout_marginTop="@dimen/margin_small"
                    android:paddingRight="@dimen/margin_medium"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_company_header"
                    android:layout_marginStart="16dp"/>
            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_company_name_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/margin_normal"
                    android:paddingTop="@dimen/margin_small"
                    android:textSize="@dimen/text_large_size"
                    android:paddingRight="8dp"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/Company_Code"
                    app:layout_constraintTop_toBottomOf="@+id/tv_com"
                    app:layout_constraintStart_toStartOf="@+id/ln_profile"
                    android:layout_marginTop="8dp"/>
            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_com_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="@font/custom_regular"
                    android:textSize="@dimen/text_large_size"
                    app:layout_constraintTop_toBottomOf="@id/tv_com"
                    android:gravity="end"
                    android:layout_marginTop="@dimen/margin_small"
                    android:paddingRight="@dimen/margin_medium"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_company_name_header"
                    android:layout_marginStart="16dp"
            />
        </android.support.constraint.ConstraintLayout>
        <android.support.constraint.ConstraintLayout
                android:id="@+id/ln_languages"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/margin_small"
                android:visibility="visible"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/layout_settings"
                app:layout_constraintEnd_toEndOf="@id/layout_settings"
                app:layout_constraintTop_toBottomOf="@+id/ln_profile"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginRight="@dimen/margin_normal"
                android:background="@drawable/bg_white_corner_radius"
        >

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_normal"
                    android:textSize="@dimen/text_large_size"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/change_languages"
                    app:layout_constraintTop_toTopOf="@id/ln_languages"
                    app:layout_constraintStart_toStartOf="@+id/ln_languages"

            />

            <android.support.constraint.ConstraintLayout
                    android:id="@+id/ln_languages_group"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/tv_change"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ln_languages"
                    android:layout_marginTop="16dp"
                    app:layout_constraintHorizontal_bias="0.5">

                <android.support.v7.widget.AppCompatTextView
                        android:id="@+id/tv_th"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ไทย"
                        android:fontFamily="@font/custom_regular"
                        android:textSize="@dimen/text_large_size"
                        app:layout_constraintTop_toTopOf="@id/ln_languages_group"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_bias="0.5" app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginRight="@dimen/margin_medium"/>

                <android.support.v7.widget.AppCompatTextView
                        android:id="@+id/tv_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:fontFamily="@font/custom_regular"
                        android:textSize="@dimen/text_large_size"
                        android:layout_marginLeft="@dimen/margin_medium"
                        app:layout_constraintTop_toTopOf="@id/ln_languages_group"
                        app:layout_constraintStart_toEndOf="@+id/tv_th"

                        android:layout_marginEnd="8dp" app:layout_constraintEnd_toEndOf="parent"/>


            </android.support.constraint.ConstraintLayout>


        </android.support.constraint.ConstraintLayout>
        <android.support.constraint.ConstraintLayout
                android:visibility="visible"
                android:id="@+id/ln_offline"
                android:layout_width="0dp"
                android:layout_height="60dp"
                app:layout_constraintStart_toStartOf="@id/layout_settings"
                app:layout_constraintEnd_toEndOf="@id/layout_settings"
                app:layout_constraintTop_toBottomOf="@+id/ln_languages"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginRight="@dimen/margin_normal"
                android:background="@drawable/bg_white_corner_radius"
                app:layout_constraintHorizontal_bias="0.5">

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_offline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_normal"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/Offline_mode"
                    android:textSize="@dimen/text_large_size"
                    app:layout_constraintTop_toTopOf="@id/ln_offline"
                    app:layout_constraintStart_toStartOf="@+id/ln_offline"/>
            <android.support.constraint.ConstraintLayout

                    android:id="@+id/offline_switch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_offline"
                    app:layout_constraintEnd_toEndOf="@+id/ln_offline"
            >
                <Switch android:id="@+id/switch_private"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="@+id/offline_switch"
                        app:layout_constraintBottom_toBottomOf="@+id/offline_switch"
                        app:layout_constraintEnd_toEndOf="@+id/offline_switch"
                        android:paddingRight="@dimen/margin_xlarge"
                        android:gravity="right"/>
            </android.support.constraint.ConstraintLayout>

        </android.support.constraint.ConstraintLayout>

        <android.support.constraint.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/ln_noti"
                android:layout_width="0dp"
                android:layout_height="60dp"
                app:layout_constraintStart_toStartOf="@id/layout_settings"
                app:layout_constraintEnd_toEndOf="@id/layout_settings"
                app:layout_constraintTop_toBottomOf="@+id/ln_offline"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginRight="@dimen/margin_normal"
                android:background="@drawable/bg_white_corner_radius"
                app:layout_constraintHorizontal_bias="0.5">

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/tv_noti"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_normal"
                    android:fontFamily="@font/custom_regular"
                    android:text="@string/noti_mode"
                    android:textSize="@dimen/text_large_size"
                    app:layout_constraintTop_toTopOf="@id/ln_noti"
                    app:layout_constraintStart_toStartOf="@+id/ln_noti"/>
            <android.support.constraint.ConstraintLayout

                    android:id="@+id/noti_switch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_noti"
                    app:layout_constraintEnd_toEndOf="@+id/tv_noti"
            >
                <Switch android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="@+id/noti_switch"
                        app:layout_constraintBottom_toBottomOf="@+id/noti_switch"
                        app:layout_constraintEnd_toEndOf="@+id/noti_switch"
                        android:paddingRight="@dimen/margin_xlarge"
                        android:gravity="right"/>
            </android.support.constraint.ConstraintLayout>

        </android.support.constraint.ConstraintLayout>

    </android.support.constraint.ConstraintLayout>

</android.support.constraint.ConstraintLayout>

