<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             android:layout_width="wrap_content"
                                             android:layout_height="wrap_content"
                                             xmlns:app="http://schemas.android.com/apk/res-auto"
                                             android:paddingBottom="@dimen/margin_12"
                                             android:paddingTop="@dimen/margin_12"
                                             android:paddingStart="@dimen/padding_large"
                                             android:paddingEnd="@dimen/padding_large"
                                             android:background="@drawable/menu_corner_radius"
                                             android:orientation="vertical"
                                             android:layout_margin="16dp">


        <android.support.v7.widget.AppCompatTextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txtAddress"
                android:textSize="16sp"
                android:maxLines="3"
                android:textColor="@color/darkblue"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
        />

    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:maxLines="3"
            android:layout_marginStart="5dp"
            android:text="location"
            android:textColor="@color/Green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/txt_title"
    />


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txt_position"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/txtPosition"
            android:textSize="14sp"
            android:layout_marginRight="5dp"
            android:textColor="@color/darkblue"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="parent"/>


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/position"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="0.0"
            android:layout_marginStart="5dp"
            android:textSize="12sp"
            android:textColor="@color/Green"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toEndOf="@id/txt_position"/>



    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/txtSeperate"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=","
            android:textSize="14sp"
            android:textColor="@color/Green"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toEndOf="@id/position"/>


    <android.support.v7.widget.AppCompatTextView
            android:id="@+id/position2"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="0.0"
            android:textSize="12sp"
            android:textColor="@color/Green"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtSeperate" app:layout_constraintHorizontal_bias="0.0"/>

