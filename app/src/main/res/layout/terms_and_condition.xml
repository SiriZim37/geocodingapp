<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:gravity="center_horizontal"
              android:background="@color/color_white"
              android:orientation="vertical">

    <ScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:gravity="center_horizontal"
                      android:orientation="vertical">

            <android.support.v7.widget.AppCompatTextView
                    android:id="@+id/txt_termsandcons"
                    android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:textSize="@dimen/text_xxlarge_size"
                      android:textColor="@color/geo_black"
                    android:gravity="center"
                    android:layout_gravity="center"
                      android:text="@string/terms_and_conditions"
                      android:fontFamily="@font/custom_regular"
                      android:layout_marginTop="@dimen/margin_xxlarge"
                    android:layout_marginLeft="@dimen/padding_large"
                    android:layout_marginRight="@dimen/padding_large"

            />

            <ImageView android:layout_width="75dp"
                       android:layout_height="60dp"
                       android:background="@drawable/conditionimg"/>

            <LinearLayout android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginLeft="@dimen/margin_xlarge"
                          android:layout_marginRight="@dimen/margin_xlarge"
                          android:layout_marginBottom="@dimen/margin_xlarge"
                          android:layout_marginTop="@dimen/margin_small"
                          android:background="@drawable/bg_white_corner_radius">

                <WebView
                        android:id="@+id/webview_termsandcons"
                        android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_margin="@dimen/margin_normal">

                </WebView>
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/agree"
                    android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:orientation="horizontal"
                          android:paddingLeft="@dimen/margin_xlarge">
                <CheckBox
                        android:id="@+id/check_accept"
                        android:layout_width="40dp"
                          android:layout_height="40dp"/>
                <TextView
                        android:id="@+id/tv_agree"
                        android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="@string/i_agree_on_disclosure_information"
                          android:textColor="@color/geo_black"
                          android:textSize="@dimen/text_medium_size"
                          android:fontFamily="@font/custom_regular"/>
            </LinearLayout>
            <LinearLayout
                    android:id="@+id/disagree"
                    android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:orientation="horizontal"
                          android:paddingLeft="@dimen/margin_xlarge">
                <CheckBox
                        android:id="@+id/check_not_accept"
                        android:layout_width="40dp"
                        android:layout_height="40dp"/>
                <TextView
                        android:id="@+id/tv_disagree"
                        android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="@string/i_dont_agree_on_disclosure_information"
                          android:textColor="@color/geo_black"
                          android:textSize="@dimen/text_medium_size"
                          android:fontFamily="@font/custom_regular"/>
            </LinearLayout>
            <Button
                    android:id="@+id/bt_terms_next"
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:fontFamily="@font/custom_regular"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_large_size"
                    android:background="@drawable/selector_btn_confirm_darkblue"
                    android:layout_marginLeft="@dimen/margin_xlarge"
                    android:layout_marginRight="@dimen/margin_xlarge"
                    android:layout_marginTop="@dimen/margin_normal"
                    android:layout_marginBottom="@dimen/margin_xlarge"/>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
